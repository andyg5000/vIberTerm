{
  "name": "vibeterm",
  "version": "0.1.0",
  "description": "Web-based terminal manager for Linux with tmux-backed tab/pane system",
  "main": "dist/server/server.js",
  "bin": {
    "vibeterm": "./bin/vibeterm"
  },
  "files": [
    "dist/",
    "public/",
    "bin/",
    "scripts/ensure-native-modules.js",
    "scripts/postinstall-npm.js",
    "node-pty/lib/",
    "node-pty/package.json",
    "node-pty/binding.gyp",
    "node-pty/src/",
    "node-pty/tsconfig.json",
    "prebuilds/",
    "README.md"
  ],
  "os": [
    "linux"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "clean": "node scripts/clean.js",
    "dev": "node scripts/dev.js",
    "dev:server": "tsx watch src/cli.ts --no-auth",
    "dev:client": "node scripts/dev.js --client-only",
    "build": "node scripts/build.js",
    "build:ci": "node scripts/build-ci.js",
    "lint": "biome check src",
    "lint:fix": "biome check src --write",
    "typecheck": "concurrently -n server,client,sw \"tsc --noEmit --project tsconfig.server.json\" \"tsc --noEmit --project tsconfig.client.json\" \"tsc --noEmit --project tsconfig.sw.json\"",
    "pretest": "node scripts/ensure-native-modules.js",
    "test": "vitest",
    "test:ci": "npm run pretest && vitest run --reporter=verbose",
    "test:coverage": "vitest run --coverage",
    "format": "biome format src --write",
    "format:check": "biome format src",
    "precommit": "pnpm run format && pnpm run lint:fix && pnpm run typecheck",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "prepare": "husky"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "authenticate-pam",
      "esbuild",
      "node-pty"
    ]
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "compression": "^1.8.1",
    "express": "^5.2.1",
    "ghostty-web": "^0.4.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "lit": "^3.3.2",
    "mime-types": "^3.0.2",
    "monaco-editor": "^0.55.1",
    "multer": "^2.0.2",
    "node-addon-api": "^8.5.0",
    "node-pty": "file:node-pty",
    "signal-exit": "^4.1.0",
    "web-push": "^3.6.7",
    "ws": "^8.18.3",
    "zod": "^4.2.1"
  },
  "optionalDependencies": {
    "authenticate-pam": "^1.0.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@open-wc/testing": "^4.0.0",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mime-types": "^3.0.1",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.3",
    "@types/supertest": "^6.0.3",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "autoprefixer": "^10.4.23",
    "chokidar": "^5.0.0",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.27.2",
    "happy-dom": "^20.0.11",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "node-fetch": "^3.3.2",
    "oxlint": "^1.35.0",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "prettier": "^3.7.4",
    "supertest": "^7.1.4",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "uuid": "^13.0.0",
    "vite": "8.0.0-beta.5",
    "vitest": "^4.0.16",
    "ws-mock": "^0.1.0"
  },
  "keywords": [
    "terminal",
    "tmux",
    "websocket",
    "web-terminal"
  ],
  "author": "",
  "license": "MIT",
  "lint-staged": {
    "src/**/*.{ts,tsx,js,jsx}": [
      "biome check --write",
      "bash -c 'tsc --noEmit --project tsconfig.server.json'",
      "bash -c 'tsc --noEmit --project tsconfig.client.json'",
      "bash -c 'tsc --noEmit --project tsconfig.sw.json'"
    ]
  },
  "packageManager": "pnpm@10.15.0+sha512.486ebc259d3e999a4e8691ce03b5cac4a71cbeca39372a9b762cb500cfdf0873e2cb16abe3d951b1ee2cf012503f027b98b6584e4df22524e0c7450d9ec7aa7b"
}
